# Local-only development defaults. Replace credentials and origins before remote deployment.
POSTGRES_PASSWORD=browsergrid-local-development-only
MINIO_ROOT_USER=browsergrid-local
MINIO_ROOT_PASSWORD=browsergrid-local-development-only
BG_ORIGINS=http://localhost:3000
BG_S3_PUBLIC_ENDPOINT=http://localhost:9000
BG_SECURE_COOKIES=false
# Encryption key is generated once by init and persisted in the state volume.
